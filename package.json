{
  "name": "Mobius",
  "version": "1.0.0",
  "description": "AI-powered IDE — VS Code OSS + Continue",
  "private": true,
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/launch-ide.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/launch-ide.ps1",
    "build": "npm run build:vscode",
    "rebuild": "powershell -ExecutionPolicy Bypass -File scripts/rebuild.ps1",
    "install:all": "npm run install:continue && npm run build:vscode",
    "install:continue": "powershell -ExecutionPolicy Bypass -File scripts/install-continue.ps1",
    "sync:gui": "powershell -ExecutionPolicy Bypass -File scripts/sync-continue-gui.ps1",
    "postsync:gui": "powershell -Command \"Write-Host 'Continue GUI synced into the extension.' -ForegroundColor Green; Write-Host 'Reload the IDE window (Developer: Reload Window) to see chat panel changes.' -ForegroundColor Cyan\"",
    "sync:config": "powershell -ExecutionPolicy Bypass -File scripts/sync-continue-config.ps1",
    "ensure:sqlite": "powershell -ExecutionPolicy Bypass -File scripts/ensure-sqlite.ps1",
    "build:vscode": "powershell -ExecutionPolicy Bypass -File scripts/build-vscode.ps1",
    "install:vscode": "powershell -ExecutionPolicy Bypass -File scripts/install-vscode-deps.ps1",
    "rebuild:native": "powershell -ExecutionPolicy Bypass -File scripts/rebuild-native-modules.ps1",
    "install:vscode:js": "powershell -ExecutionPolicy Bypass -File scripts/install-vscode-js-deps.ps1",
    "compile": "powershell -ExecutionPolicy Bypass -File scripts/compile-vscode.ps1",
    "compile:vscode": "powershell -ExecutionPolicy Bypass -File scripts/compile-vscode.ps1",
    "compile:safe": "powershell -ExecutionPolicy Bypass -File scripts/raise-ulimit.ps1 vscode-win32-x64-min",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check-prerequisites.ps1",
    "bundle:ollama": "powershell -ExecutionPolicy Bypass -File scripts/bundle-ollama.ps1",
    "godot:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-godot.ps1",
    "godot:init": "node scripts/godot-mcp-server.js --init",
    "godot:import": "node scripts/godot-mcp-server.js --import",
    "godot:run": "node scripts/godot-mcp-server.js --run",
    "godot:test": "node scripts/godot-mcp-server.js --test",
    "godot:detect": "node scripts/godot-mcp-server.js --detect",
    "godot:preview": "node scripts/godot-mcp-server.js --preview",
    "godot:editor": "node scripts/godot-mcp-server.js --preview --editor",
    "godot:play": "node scripts/godot-mcp-server.js --play",
    "game-dev": "node scripts/godot-mcp-server.js --self-test",
    "verify:ollama": "powershell -ExecutionPolicy Bypass -File scripts/verify-ollama-bundle.ps1",
    "setup:ollama": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "ensure:minilm": "powershell -ExecutionPolicy Bypass -File scripts/ensure-minilm.ps1",
    "verify:minilm": "node scripts/verify-minilm.mjs",
    "postsync:config": "powershell -Command \"Write-Host 'Synced config/continue-config.yaml + .env -> ~/.continue/config.yaml' -ForegroundColor Green; Write-Host 'Reload Continue config in the IDE (Continue: Reload Config). No rebuild needed for config-only changes.' -ForegroundColor Cyan\"",
    "web": "powershell -ExecutionPolicy Bypass -File scripts/serve-web.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "package": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Target user\"",
    "package:user": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Target user\"",
    "package:system": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Target system\"",
    "package:win32": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Arch x64 -Target user\"",
    "package:arm64": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Arch arm64 -Target user\"",
    "package:fast": "powershell -ExecutionPolicy Bypass -Command \"$env:SKIP_OLLAMA_BUNDLE='1'; $env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Target user\"",
    "package:fast:win32": "powershell -ExecutionPolicy Bypass -Command \"$env:SKIP_OLLAMA_BUNDLE='1'; $env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Arch x64 -Target user\"",
    "package:fast:arm64": "powershell -ExecutionPolicy Bypass -Command \"$env:SKIP_OLLAMA_BUNDLE='1'; $env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Arch arm64 -Target user\"",
    "package:setup": "powershell -ExecutionPolicy Bypass -Command \"$env:SKIP_OLLAMA_BUNDLE='1'; $env:SKIP_VSCODE_BUILD='1'; $env:SKIP_CONTINUE_BUILD='1'; & './scripts/package.ps1' -Target user\"",
    "package:incremental": "powershell -ExecutionPolicy Bypass -Command \"$env:SKIP_OLLAMA_BUNDLE='1'; $env:SKIP_CONTINUE_BUILD='1'; $env:PACKAGE_INCREMENTAL='1'; & './scripts/package.ps1' -Target user\"",
    "package:full": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_FULL='1'; & './scripts/package.ps1' -Target user\"",
    "package:full:win32": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_FULL='1'; & './scripts/package.ps1' -Arch x64 -Target user\"",
    "package:full:arm64": "powershell -ExecutionPolicy Bypass -Command \"$env:PACKAGE_FULL='1'; & './scripts/package.ps1' -Arch arm64 -Target user\"",
    "gulp:vscode-min": "powershell -ExecutionPolicy Bypass -File scripts/gulp-vscode-min.ps1",
    "gulp:vscode-min:x64": "powershell -ExecutionPolicy Bypass -File scripts/gulp-vscode-min.ps1 -Arch x64",
    "gulp:vscode-min:arm64": "powershell -ExecutionPolicy Bypass -File scripts/gulp-vscode-min.ps1 -Arch arm64",
    "prepackage": "powershell -ExecutionPolicy Bypass -File scripts/verify-ollama-bundle.ps1",
    "verify:grep": "powershell -ExecutionPolicy Bypass -File scripts/verify-grep-search-fix.ps1",
    "restart:mobius": "powershell -ExecutionPolicy Bypass -File scripts/restart-mobius.ps1",
    "hooks:install": "powershell -ExecutionPolicy Bypass -File scripts/install-git-hooks.ps1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
