# Mobius — copy to .env and fill in API keys
# Set AI_ACTIVE_PROFILE to the default profile id (startup / orphan fallback).
# Switching in Model Provider UI or Agents picker is session-only and does not
# rewrite AI_ACTIVE_PROFILE — edit this file to change the default.
AI_ACTIVE_PROFILE=openai

[openai]
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# Example additional profile:
# [siliconflow]
# AI_PROVIDER=siliconflow
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_API_KEY=
# AI_MODEL=deepseek-ai/DeepSeek-V3
